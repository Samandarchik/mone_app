PORT=3000
DB_URL=postgres://konak:CHANGE_ME@localhost:5432/konak_pos?sslmode=disable
# Kamida 32 belgili tasodifiy qiymat. Ishlab turgan tizimda almashtirilsa
# barcha eski login tokenlari bekor bo'ladi.
JWT_SECRET=
# Kamida 16 belgili alohida server siri. Bo'sh bo'lsa JWT_SECRET ishlatiladi.
# DB nusxasi o'g'irlanganida 4 xonali PINlarni brute-force qilishdan himoya qiladi.
PIN_PEPPER=
SERVICE_FEE_PERCENT=

# Cloud sync (ixtiyoriy) — bu qiymatlar faqat BIRINCHI ishga tushishda settings
# jadvaliga urug' bo'ladi; keyin super_admin ilova ichidan o'zgartiradi.
# Bo'sh qoldirilsa server to'liq offline ishlaydi (VPN URL ham bo'ladi).
CLOUD_WS_URL=
LOCAL_SERVER_TOKEN=

# Telegram bot (saboy / dostafka). Bo'sh qoldirilsa online buyurtma o'chiriladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Admin guruhi yoki shaxsiy chat id (xabarnoma uchun, bo'sh bo'lsa yuborilmaydi)
TELEGRAM_ADMIN_CHAT_ID=

# Har kuni shifrlangan PostgreSQL backup. Kalit bo'sh bo'lsa PIN_PEPPER ishlatiladi.
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=3
# Windows'da kerak bo'lsa pg_dump.exe / pg_restore.exe to'liq manzilini kiriting.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore

# QR mijoz Flutter web buildi va stollarga chiqariladigan public URL.
CUSTOMER_WEB_DIR=./customer_web
CUSTOMER_PUBLIC_URL=
